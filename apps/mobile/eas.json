{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "node": "20.18.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spa-api-sfx7.onrender.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "20.18.0",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spa-api-sfx7.onrender.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
