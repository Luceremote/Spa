// Spa Software - Schema Prisma
// Modelos: usuarios admin, clientes, categorías, servicios, reservas, pagos, tema, config, staff,
// cupones, días cerrados, eventos de seguridad, 2FA, tokens push.

generator client {
  provider      = "prisma-client-js"
  // Render/Docker corren Alpine (musl). Incluimos ambos para que funcione local (Windows) y en prod.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE_CARD
  CASH
  TRANSFER
  OTHER
}

enum CouponType {
  PERCENT     // descuento en porcentaje
  FIXED       // descuento de monto fijo (centavos)
}

enum TxType {
  INCOME
  EXPENSE
}

enum TxSource {
  MANUAL
  BOOKING
  GIFT_CARD
  RECURRING
  REFUND
}

enum RecurFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum GiftCardStatus {
  PENDING_PAYMENT  // creada, esperando que Stripe confirme el pago
  ACTIVE           // pagada, con saldo disponible
  USED_UP          // saldo agotado
  EXPIRED
  REFUNDED
  CANCELLED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            Role      @default(ADMIN)
  failedLoginAttempts Int   @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  tokenVersion    Int       @default(0)
  // 2FA TOTP
  totpEnabled     Boolean   @default(false)
  totpSecret      String?
  recoveryCodes   String[]  @default([]) // hashes de códigos de respaldo de un solo uso
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String
  notes     String?   // notas del cliente sobre sí mismo (alergias indicadas al reservar)
  privateNotes String? // notas privadas del admin (no visibles al cliente)
  bookings  Booking[]
  pushTokens PushToken[]
  loyaltyAccount LoyaltyAccount?
  packagePurchases PackagePurchase[] @relation("CustomerPackages")
  membership CustomerMembership? @relation("CustomerMembership")
  // Última vez que se le envió un email de "te extrañamos" (para no spammear)
  lastFollowupAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([phone])
  @@index([email])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String
  priceCents      Int
  durationMinutes Int
  imageUrl        String?
  active          Boolean   @default(true)
  featured        Boolean   @default(false)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staff           Staff[]   @relation("StaffServices")
  bookings        Booking[]
  packages        ServicePackage[] @relation("ServicePackages")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active])
  @@index([categoryId])
}

// Profesional / terapeuta / colaborador. Permite asignar una reserva a una persona específica.
model Staff {
  id           String    @id @default(cuid())
  name         String
  email        String?
  phone        String?
  bio          String?
  avatarUrl    String?
  active       Boolean   @default(true)
  // Disponibilidad: bitmask de días (0=Dom .. 6=Sáb). Ej. [1,2,3,4,5] = lunes-viernes
  workingDays  Int[]     @default([1, 2, 3, 4, 5, 6])
  // Hora de inicio/fin en minutos desde medianoche (e.g. 540 = 9:00, 1140 = 19:00)
  workingFrom  Int       @default(540)
  workingTo    Int       @default(1140)
  // Comisión: % sobre el precio del servicio (0-100). 0 = sin comisión, sueldo fijo aparte.
  commissionPercent Float @default(0)
  // Servicios que puede realizar (si vacío => todos)
  services     Service[] @relation("StaffServices")
  bookings     Booking[]
  blocks       StaffBlock[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Bloqueo personal de un staff: rango de tiempo en que NO atiende.
// Útil para vacaciones individuales, citas médicas, etc., sin afectar a los demás.
model StaffBlock {
  id        String   @id @default(cuid())
  staffId   String
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([staffId, startAt])
}

// Inventario de productos del spa (no servicios; productos físicos para venta o uso interno)
model Product {
  id           String   @id @default(cuid())
  name         String
  sku          String?  @unique
  description  String?
  stock        Int      @default(0)
  unit         String?  // "unidad", "ml", "litro", "kg"
  costCents    Int?     // costo de adquisición (para margen)
  priceCents   Int?     // precio de venta al cliente (null = no se vende, solo uso interno)
  lowStockAlert Int     @default(5) // genera aviso si stock <= alerta
  imageUrl     String?
  active       Boolean  @default(true)
  movements    ProductMovement[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

// Historial de movimientos de stock (entrada/salida/ajuste)
model ProductMovement {
  id         String              @id @default(cuid())
  productId  String
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  type       ProductMovementType
  quantity   Int                 // siempre positivo; "type" indica signo
  unitCostCents Int?
  note       String?
  createdAt  DateTime            @default(now())

  @@index([productId, createdAt])
}

enum ProductMovementType {
  IN          // entrada (compra, devolución de proveedor)
  OUT         // salida (uso interno, venta)
  ADJUSTMENT  // ajuste manual (inventario físico)
}

// ─── MARKETING ────────────────────────────────────────────
enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

// Campaña de email a suscriptores (broadcast)
model EmailCampaign {
  id           String         @id @default(cuid())
  subject      String
  htmlBody     String         // HTML completo del email
  preheader    String?        // preview text
  status       CampaignStatus @default(DRAFT)
  sentAt       DateTime?
  recipientCount Int          @default(0)
  successCount   Int          @default(0)
  failedCount    Int          @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// Banner promocional configurable en home (singleton)
model PromoBanner {
  id          String   @id @default("singleton")
  active      Boolean  @default(false)
  text        String   @default("")        // texto del banner
  ctaLabel    String?  // ej. "Reservar"
  ctaUrl      String?  // ej. "/reservar"
  bgColor     String   @default("340 75% 55%")   // HSL
  textColor   String   @default("0 0% 100%")
  dismissible Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

// Pop-up de descuento para visitantes nuevos (singleton)
model PromoPopup {
  id          String   @id @default("singleton")
  active      Boolean  @default(false)
  title       String   @default("¡Bienvenido!")
  body        String   @default("10% de descuento en tu primera reserva")
  ctaLabel    String   @default("Quiero el descuento")
  ctaUrl      String   @default("/reservar")
  imageUrl    String?
  showAfterSec Int     @default(5)         // segundos antes de mostrar
  showOncePerDays Int  @default(7)         // no repetir antes de N días
  updatedAt   DateTime @updatedAt
}

// Programa de lealtad: puntos acumulables y canjeables
model LoyaltyAccount {
  id          String              @id @default(cuid())
  customerId  String              @unique
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pointsBalance Int               @default(0)
  totalEarned Int                 @default(0)
  totalRedeemed Int               @default(0)
  movements   LoyaltyMovement[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([pointsBalance])
}

enum LoyaltyMovementType {
  EARN
  REDEEM
  ADJUSTMENT
  EXPIRE
}

model LoyaltyMovement {
  id         String              @id @default(cuid())
  accountId  String
  account    LoyaltyAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type       LoyaltyMovementType
  points     Int                 // positivo siempre; type indica signo
  bookingId  String?             // si fue por una reserva
  note       String?
  createdAt  DateTime            @default(now())

  @@index([accountId, createdAt])
}

// Reglas globales del programa (singleton)
model LoyaltySettings {
  id              String   @id @default("singleton")
  active          Boolean  @default(false)
  pointsPerDollar Float    @default(1.0)    // 1 punto por cada $1 gastado
  pointValueCents Int      @default(1)      // 1 punto = $0.01 al canjear
  minRedeemPoints Int      @default(500)    // mínimo para canjear
  updatedAt       DateTime @updatedAt
}

model Booking {
  id          String        @id @default(cuid())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  staffId     String?
  staff       Staff?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  startAt     DateTime
  endAt       DateTime
  status      BookingStatus @default(PENDING)
  priceCents      Int       // monto final a cobrar (después de descuento)
  basePriceCents  Int       // precio del servicio antes de cupón/gift card
  discountCents   Int       @default(0)
  couponId        String?
  coupon          Coupon?   @relation(fields: [couponId], references: [id], onDelete: SetNull)
  redemptions     GiftCardRedemption[]
  packageRedemption PackageRedemption?
  notes       String?
  reminderSentAt        DateTime? // push reminder (~1h antes)
  emailReminderSentAt   DateTime? // email reminder (~24h antes)
  surveySentAt          DateTime? // email post-servicio (encuesta/reseña)
  payment     Payment?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([startAt])
  @@index([status])
  @@index([staffId, startAt])
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  booking               Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountCents           Int
  currency              String        @default("usd")
  method                PaymentMethod @default(STRIPE_CARD)
  status                PaymentStatus @default(PENDING)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?       @unique
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

// Cupones / códigos promo
model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  // Si type=PERCENT: porcentaje 1-100. Si type=FIXED: centavos.
  value         Int
  active        Boolean    @default(true)
  expiresAt     DateTime?
  maxUses       Int?       // límite total de usos (null = ilimitado)
  usedCount     Int        @default(0)
  minPriceCents Int?       // monto mínimo para aplicarlo
  bookings      Booking[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([active])
}

// Gift Cards / tarjetas de regalo (con saldo prepagado)
model GiftCard {
  id                String         @id @default(cuid())
  // Código único que el destinatario usa al reservar (mostrado al comprador)
  code              String         @unique
  initialCents      Int            // valor cargado al comprar
  balanceCents      Int            // saldo restante actual
  currency          String         @default("usd")
  status            GiftCardStatus @default(PENDING_PAYMENT)
  // Datos del comprador (quien paga)
  purchaserName     String
  purchaserEmail    String
  // Datos del destinatario (puede ser el mismo comprador o un regalo)
  recipientName     String?
  recipientEmail    String?
  // Mensaje personalizado del comprador para el destinatario
  message           String?
  // Pago vía Stripe Checkout
  stripeSessionId       String?    @unique
  stripePaymentIntentId String?    @unique
  paidAt                DateTime?
  expiresAt             DateTime?  // null = no expira
  redemptions           GiftCardRedemption[]
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@index([status])
  @@index([purchaserEmail])
  @@index([recipientEmail])
}

// Cada vez que una gift card se usa en una reserva, se registra aquí
model GiftCardRedemption {
  id           String   @id @default(cuid())
  giftCardId   String
  giftCard     GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amountCents  Int      // cuánto se descontó del saldo
  createdAt    DateTime @default(now())

  @@index([giftCardId])
  @@index([bookingId])
}

// Días cerrados / vacaciones del spa
model ClosedDate {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date // sólo fecha (sin hora)
  reason    String?
  createdAt DateTime @default(now())
}

model SiteConfig {
  id            String   @id @default("singleton")
  spaName       String   @default("Mi Spa")
  tagline       String   @default("Relájate, eres bienvenido")
  logoUrl       String?
  heroImageUrl  String?
  whatsappPhone String   @default("15555555555")
  whatsappMsg   String   @default("Hola, me gustaría reservar un servicio")
  callPhone     String?  // teléfono separado para llamar (puede ser distinto del WhatsApp)
  email         String?
  address       String?
  googleMapsUrl String?  // URL embed o de búsqueda en Google Maps
  openingHours  String?  // resumen legible: "Lun-Sáb 9:00-19:00"
  // Horarios desglosados (JSON con keys mon, tue, wed, thu, fri, sat, sun → "10:00-19:00" o "Cerrado")
  hoursByDay    Json?
  // Bio / sobre nosotros
  aboutTitle    String?
  aboutText     String?  // párrafo largo, puede tener múltiples líneas
  aboutImageUrl String?
  // Redes sociales (URLs completas)
  instagramUrl  String?
  facebookUrl   String?
  tiktokUrl     String?
  twitterUrl    String?
  youtubeUrl    String?
  // Políticas (texto largo, formato markdown opcional)
  cancellationPolicy String?
  privacyPolicy      String?
  termsOfService     String?
  // Activa métodos de pago "Compra ahora, paga después" en Stripe Checkout (Klarna/Afterpay/Affirm)
  enableBnpl    Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

// Reseñas / testimonios de clientes
model Review {
  id           String   @id @default(cuid())
  authorName   String
  authorEmail  String?  // opcional, no se muestra públicamente
  rating       Int      // 1-5 estrellas
  comment      String
  serviceName  String?  // qué servicio le dio (texto libre)
  published    Boolean  @default(false) // admin debe aprobar antes de mostrar
  featured     Boolean  @default(false) // destacada (aparece en landing)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, featured, createdAt])
}

// Suscriptores al newsletter / promos
model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  source      String?  // "footer", "checkout", etc
  active      Boolean  @default(true)
  unsubscribedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([active])
}

// Fotos de la galería pública del spa
model Photo {
  id          String   @id @default(cuid())
  url         String
  caption     String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, order])
}

model Theme {
  id              String   @id @default("singleton")
  colorPrimary    String   @default("340 75% 55%")
  colorSecondary  String   @default("160 40% 70%")
  colorAccent     String   @default("45 90% 70%")
  colorBackground String   @default("30 40% 98%")
  colorForeground String   @default("220 15% 20%")
  colorMuted      String   @default("30 20% 92%")
  colorHeader     String   @default("30 40% 98%")   // color de la barra superior (navbar)
  borderRadius    String   @default("0.75rem")
  cardPadding     String   @default("1.5rem")
  containerWidth  String   @default("1200px")
  fontFamily      String   @default("Inter")
  fontSizeBase    String   @default("16px")
  template        String   @default("elegant")
  updatedAt       DateTime @updatedAt
}

// Tokens de Expo Push (cliente opta por recibir notificaciones)
model PushToken {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  platform   String?  // "ios" | "android"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// ─── FINANZAS / CARTERA ───────────────────────────────────
model FinanceCategory {
  id             String   @id @default(cuid())
  name           String
  type           TxType
  color          String?  // hex para gráficas (#xxxxxx)
  icon           String?  // ej: "home", "shopping-cart"
  isDefault      Boolean  @default(false)
  transactions   Transaction[]
  recurrings     RecurringTransaction[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([name, type])
}

model Transaction {
  id          String           @id @default(cuid())
  type        TxType
  source      TxSource         @default(MANUAL)
  amountCents Int              // siempre positivo; el "type" determina signo
  date        DateTime         // fecha contable (puede ser distinta del createdAt)
  description String?
  note        String?
  categoryId  String?
  category    FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bookingId   String?          // si vino de una reserva
  giftCardId  String?          // si vino de una gift card
  receiptUrl  String?          // foto/PDF de factura/recibo
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type, date])
  @@index([categoryId])
  @@index([bookingId])
  @@index([giftCardId])
}

model RecurringTransaction {
  id           String           @id @default(cuid())
  name         String           // ej. "Arriendo local"
  amountCents  Int
  type         TxType
  categoryId   String?
  category     FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency    RecurFrequency   @default(MONTHLY)
  dayOfMonth   Int?             // 1-31 para MONTHLY/YEARLY
  monthOfYear  Int?             // 1-12 para YEARLY
  weekday      Int?             // 0-6 para WEEKLY
  active       Boolean          @default(true)
  nextDueDate  DateTime         // cuándo se genera la próxima Transaction
  lastRunAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([active, nextDueDate])
}

// ─── VENTAS / PAQUETES / MEMBRESÍAS ───────────────────────
enum PackagePurchaseStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  USED_UP
  CANCELLED
}

// Paquete de N sesiones de un servicio a precio reducido
model ServicePackage {
  id            String   @id @default(cuid())
  serviceId     String
  service       Service  @relation("ServicePackages", fields: [serviceId], references: [id], onDelete: Cascade)
  name          String
  sessions      Int      // cantidad de sesiones incluidas
  priceCents    Int      // precio total del paquete
  validityDays  Int      @default(365) // días desde la compra hasta que expira
  active        Boolean  @default(true)
  purchases     PackagePurchase[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([serviceId, active])
}

// Compra concreta de un paquete por un cliente (lleva el saldo de sesiones)
model PackagePurchase {
  id                String                @id @default(cuid())
  packageId         String
  package           ServicePackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer              @relation("CustomerPackages", fields: [customerId], references: [id], onDelete: Cascade)
  sessionsTotal     Int                   // copia del paquete (por si cambia después)
  sessionsRemaining Int
  status            PackagePurchaseStatus @default(PENDING_PAYMENT)
  paidCents         Int
  expiresAt         DateTime
  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique
  paidAt                DateTime?
  redemptions       PackageRedemption[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([customerId, status])
  @@index([status])
}

model PackageRedemption {
  id         String          @id @default(cuid())
  purchaseId String
  purchase   PackagePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  bookingId  String          @unique
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@index([purchaseId])
}

// Tier de membresía: configuración (singletons por nombre)
model MembershipTier {
  id              String   @id @default(cuid())
  name            String   @unique         // ej. "Bronce", "Plata", "Oro"
  description     String?
  monthlyPriceCents Int                    // precio referencial mensual
  discountPercent Float                    // descuento que aplica en cada reserva (0-100)
  perks           String?                  // texto libre con beneficios
  color           String?                  // hex para badge
  active          Boolean  @default(true)
  memberships     CustomerMembership[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Membresía actual de un cliente (gestión manual; no Stripe Subscriptions todavía)
model CustomerMembership {
  id          String         @id @default(cuid())
  customerId  String         @unique
  customer    Customer       @relation("CustomerMembership", fields: [customerId], references: [id], onDelete: Cascade)
  tierId      String
  tier        MembershipTier @relation(fields: [tierId], references: [id], onDelete: Restrict)
  startedAt   DateTime       @default(now())
  expiresAt   DateTime?      // null = no expira (manual)
  active      Boolean        @default(true)
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([active, expiresAt])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  type      String
  email     String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([email, createdAt])
  @@index([ip, createdAt])
}
