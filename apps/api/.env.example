# ── Base de datos ─────────────────────────────────────────────
# Local:  postgresql://postgres:postgres@localhost:5432/spa_db?schema=public
# Neon:   postgresql://user:pass@ep-xxx.aws.neon.tech/spa_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spa_db?schema=public"

# ── JWT ──────────────────────────────────────────────────────
# Genera uno fuerte:
#   PowerShell: [Convert]::ToBase64String((1..48 | %{[byte](Get-Random -Max 256)}))
#   bash/zsh:   openssl rand -base64 48
JWT_SECRET="cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-chars-mejor-48"
JWT_EXPIRES_IN="7d"

# ── Servidor ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
TRUST_PROXY=1
MAX_BODY_KB=256

# ── Stripe (test: https://dashboard.stripe.com/test/apikeys) ─
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
CURRENCY="usd"
APP_URL="http://localhost:3000"

# ── Imágenes externas: hosts extra permitidos ─────────────────
ALLOWED_IMAGE_HOSTS=""

# ── Email (Resend, opcional) ─────────────────────────────────
RESEND_API_KEY=""
MAIL_FROM="Spa <reservas@tudominio.com>"
ADMIN_EMAIL="admin@tudominio.com"

# ── Storage de imágenes subidas ──────────────────────────────
# "local" = disco (default; bueno para dev y VPS)
# "s3"    = AWS S3 / Cloudflare R2 / MinIO (recomendado en Vercel/Render/Cloud Run)
STORAGE_DRIVER="local"
# Si STORAGE_DRIVER=s3:
S3_ENDPOINT=""           # ej. https://<account>.r2.cloudflarestorage.com  (vacío para AWS S3)
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""         # CDN o dominio público para servir los archivos

# ── 2FA TOTP ─────────────────────────────────────────────────
# Si está vacío, los secrets de TOTP se guardan en plano (no recomendado en prod).
# Genera 32+ chars aleatorios; si cambia, los 2FA actuales dejan de descifrarse.
TOTP_ENCRYPTION_KEY=""

# ── Cron (recordatorios + limpieza de logs) ─────────────────
ENABLE_CRON=true
REMINDER_MINUTES_BEFORE=60

# ── Sentry (opcional) ───────────────────────────────────────
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Re-engagement (follow-up) ───────────────────────────────
FOLLOWUP_INACTIVE_DAYS=60
FOLLOWUP_COOLDOWN_DAYS=30
FOLLOWUP_BATCH_LIMIT=50
